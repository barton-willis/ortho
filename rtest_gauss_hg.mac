(log2(x) := log(x)/log(2.0),0);
0$

(bits_in_float(x) := if bfloatp(x) then ?fpprec else 53,0);
0$

/* boa = bits of agreement. We allow a loss of at most fudge bits (currently four).  When the test fails,
   return boa, else return true. */
(boa (x,y,bits) := block([Q, diff : abs(x - y), fudge : 4],
   Q : if equal(diff,0) then bits_in_float(y)
       else (
         max(0, -log2(diff/abs(y)))),
   if Q >= bits - fudge then true else round(Q)),0);
0$

/* positive integer parameters in 1..50 and argument in interval (-1,1) */
