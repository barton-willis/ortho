(af : 0.7b0, bf: -0.8b0, xf : 10.5b0, a : rationalize(af), b : rationalize(bf), x : rationalize(xf),0);
0$

xreduce("and", makelist(approx_equal(jacobi_p(k,a,b,x), jacobi_p(k, af,bf,xf),eps),k,0,N));
true$

/* binary64 case */
(af : 0.7, bf: 1.0*%i, xf : 10.5, a : rationalize(af), b : rationalize(bf), x : rationalize(xf),0);
0$

xreduce("and", makelist(approx_equal(jacobi_p(k,a,b,x), jacobi_p(k, af,bf,xf),eps),k,0,N));
true$

/* bigfloat  case */
(af : 0.7b0, bf: 1.0b0*%i, xf : 10.5b0, a : rationalize(af), b : rationalize(bf), x : rationalize(xf),0);
0$

xreduce("and", makelist(approx_equal(jacobi_p(k,a,b,x), jacobi_p(k, af,bf,xf),eps),k,0,N));
true$

/* binary64 case */
(af : 0.7, bf: 1.0*%i, xf : -10.5, a : rationalize(af), b : rationalize(bf), x : rationalize(xf),0);
0$

xreduce("and", makelist(approx_equal(jacobi_p(k,a,b,x), jacobi_p(k, af,bf,xf),eps),k,0,N));
true$

/* bigfloat case */
(af : 0.7b0, bf: 1.0b0*%i, xf : -10.5b0, a : rationalize(af), b : rationalize(bf), x : rationalize(xf),0);
