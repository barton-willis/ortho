/* Hermite tests */
(hermite_rod(n,x) := block([an, rho, g],
   an : (-1)^n,
   rho : exp(-t^2),
   g : 1,
  rat(subst(x,t, diff(rho * g^n,t,n) / (an * rho)))),0);
  0$

block([ans : hermite(%pi,0)], [op(ans), args(ans)]);
 [hermite, [%pi, 0]]$

errcatch(hermite());
[]$

errcatch(hermite(42));
[]$

errcatch(hermite(1,2,3));
[]$

hermite(0, x);
1$

hermite(1, x);
2*x$

hermite(2, x);
2*(2*x^2-1)$

hermite(3, x);
4*(2*x^2-3)*x$

hermite(4, x);
4*(4*x^4-12*x^2+3)$

hermite(5, x);
8*(4*x^4-20*x^2+15)*x$

hermite(3, 0);
0$

hermite(4, 0);
12$

hermite(5, 1);
-8$

hermite(6, -1);
184$

hermite(6,-1)-subst(x=-1, hermite(6,x));
0$

/* --- Orthogonality checks (weight exp(-x^2)) --- */

integrate(hermite(2,x)*hermite(3,x)*exp(-x^2), x, -inf, inf);
0$

integrate(hermite(2,x)^2*exp(-x^2), x, -inf, inf);
2^2 * 2! * sqrt(%pi)$

block([ans : hermite(-1, x)], [op(ans), args(ans)]);
[hermite, [- 1, x]]$

block([ans : hermite(-1, 42)], [op(ans), args(ans)]);
[hermite, [- 1, 42]]$


