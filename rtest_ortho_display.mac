(load("ortho"), load("ortho_display"),0);
0$

/* ============================================================
   Display-format tests for all ortho package functions
   Following the hermite(n,x) pattern exactly
   ============================================================ */

/* ------------------ chebyshev_t ------------------ */
tex1(chebyshev_t(n,x));
"T_{n}\\left(x\\right)"$

with_default_2d_display(printf(false,"~m",chebyshev_t(n,x)));
"T (x)
 n
"$

with_default_2d_display(printf(false,"~m",define(f(),chebyshev_t(n,x))));
"f() := T (x)
        n
"$

/* ------------------ chebyshev_u ------------------ */
tex1(chebyshev_u(n,x));
"U_{n}\\left(x\\right)"$

with_default_2d_display(printf(false,"~m",chebyshev_u(n,x)));
"U (x)
 n
"$

with_default_2d_display(printf(false,"~m",define(f(),chebyshev_u(n,x))));
"f() := U (x)
        n
"$

