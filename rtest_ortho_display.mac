/* ------------------ jacobi ------------------ */
tex1(jacobi_p(n,a,b,x));
"P_{n}^{\\left(a,b\\right)}\\left(x\\right)"$

with_default_2d_display(printf(false,"~m",jacobi_p(n,a,b,x)));
" (a, b)
P      (x)
 n
"$

with_default_2d_display(printf(false,"~m",define(f(),jacobi_p(n,a,b,x))));
"        (a, b)
f() := P      (x)
        n
"$

